{
  "name": "@celestial-ui/vue",
  "version": "1.0.0",
  "description": "A comprehensive Vue 3 component library with atomic design principles",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "CelestialUI Team",
    "email": "support@celestialui.dev"
  },
  "homepage": "https://dev-1603.github.io/CelestialUI-Vue",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-1603/CelestialUI-Vue.git"
  },
  "bugs": {
    "url": "https://github.com/dev-1603/CelestialUI-Vue/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui-components",
    "tailwind",
    "typescript",
    "atomic-design",
    "storybook",
    "accessibility"
  ],
  "files": [
    "dist",
    "lib"
  ],
  "main": "./dist/celestial-ui.umd.js",
  "module": "./dist/celestial-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/celestial-ui.es.js",
      "require": "./dist/celestial-ui.umd.js"
    },
    "./style.css": {
      "default": "./dist/style.css"
    },
    "./themes/*": {
      "default": "./dist/themes/*"
    },
    "./atoms": {
      "types": "./dist/components/atoms/index.d.ts",
      "import": "./dist/components/atoms/index.js"
    },
    "./molecules": {
      "types": "./dist/components/molecules/index.d.ts",
      "import": "./dist/components/molecules/index.js"
    },
    "./organisms": {
      "types": "./dist/components/organisms/index.d.ts",
      "import": "./dist/components/organisms/index.js"
    },
    "./templates": {
      "types": "./dist/components/templates/index.d.ts",
      "import": "./dist/components/templates/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*",
      "import": "./lib/components/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check:lib build-lib build-demo",
    "build-lib": "vite build --config vite.config.lib.ts",
    "build-demo": "vite build --config vite.config.ts",
    "type-check:lib": "vue-tsc --build --force ./tsconfig.lib.json",
    "type-check": "vue-tsc --build --force",
    "preview": "vite preview",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:full": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook:run": "start-server-and-test 'http-server storybook-static --port 6010 --silent' http://localhost:6010 'test-storybook --url http://localhost:6010'",
    "test:storybook": "run-s build-storybook test:storybook:run",
    "test:a11y:run": "start-server-and-test 'http-server storybook-static --port 6010 --silent' http://localhost:6010 'test-storybook --url http://localhost:6010 --includeTags a11y-smoke'",
    "test:a11y": "run-s build-storybook test:a11y:run",
    "test:visual": "lost-pixel",
    "test:visual:update": "lost-pixel update",
    "test:ci": "run-s lint type-check:lib test:unit test:browser",
    "sonar:upload": "pnpm dlx @sonar/scan",
    "sonar:scan": "run-s test:coverage sonar:upload",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/ lib/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare:playwright": "playwright install chromium",
    "postinstall": "playwright install chromium",
    "prepublishOnly": "npm run build-lib",
    "release": "npm run build-lib && npm publish",
    "release:beta": "npm run build-lib && npm publish --tag beta",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "deploy:pages": "npm run build-demo && gh-pages -d dist -b gh-pages",
    "deploy:storybook": "npm run build-storybook && gh-pages -d storybook-static -b gh-pages-storybook",
    "deploy:vercel": "vercel --prod",
    "deploy:all": "npm run build && npm run build-storybook && npm run deploy:pages",
    "deploy:script": "./scripts/deploy.sh",
    "build:lib": "npm run build-lib",
    "build:demo": "npm run build-demo",
    "build:storybook": "npm run build-storybook",
    "pnpm:build": "pnpm run build",
    "pnpm:build-lib": "pnpm run build-lib",
    "pnpm:build-demo": "pnpm run build-demo",
    "pnpm:build-storybook": "pnpm run build-storybook",
    "pnpm:deploy:pages": "pnpm run build-demo && gh-pages -d dist -b gh-pages",
    "pnpm:deploy:storybook": "pnpm run build-storybook && gh-pages -d storybook-static -b gh-pages-storybook"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-actions": "^8.0.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/test": "^8.4.2",
    "@storybook/test-runner": "^0.24.4",
    "@storybook/vue3": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "1.1.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/core": "^11.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-oxlint": "^0.11.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-vue": "^9.30.0",
    "gh-pages": "^6.1.1",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "lost-pixel": "^3.22.0",
    "npm-run-all2": "^7.0.1",
    "oxlint": "^0.11.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass-embedded": "^1.85.0",
    "start-server-and-test": "^2.0.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.14",
    "terser": "^5.43.1",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^7.5.4",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "qrcode.vue": "^3.10.0"
  }
}
